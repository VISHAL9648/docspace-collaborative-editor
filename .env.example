# DocSpace Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local or hardcode secret keys in source code.

# Supabase Configuration (Available in Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key-here

# Optional: Supabase Service Role Key (Used for server-side admin operations only, never prefix with NEXT_PUBLIC_)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Application Base URL (Used for auth redirects/callbacks)
# For local dev: http://localhost:3000
# For production: https://your-docspace-app.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

    